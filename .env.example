# ARIA — environment variables

# Twilio (US local number purchased for this task)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_AGENT_ID=agent_...
ELEVENLABS_WEBHOOK_SECRET=wsec_...

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Server (port 8000 is reserved on my machine for another tunnel — using 8002 here)
SERVER_PORT=8002
PUBLIC_BASE_URL=https://<your-tunnel-url>.trycloudflare.com

# Database
DB_PATH=./aria.db

# Whisper (local backup transcription)
WHISPER_MODEL=base.en
# options: tiny.en, base.en, small.en, medium.en, large-v3
WHISPER_DEVICE=cpu
# options: cpu, cuda
WHISPER_COMPUTE_TYPE=int8
# options: int8 (cpu), float16 (cuda)
RECORDINGS_DIR=./recordings
